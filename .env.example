# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=http://localhost:3000

# GOOGLE MAPS API KEY (Leave empty if not using Google Maps)
VITE_GOOGLE_MAPS_API_KEY=

# Application Encryption Key for BYOK keys (Fernet 32-byte urlsafe base64)
APP_ENCRYPTION_KEY=

# JWT Secret (Min 32 characters)
JWT_SECRET=
ADMIN_PASSWORD=
