# ==============================================================================
# AGRIMIND AI — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Origins (comma-separated list of allowed frontend origins)
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173,https://agrimind.vercel.app

# Database Connection URL
# Local development: SQLite
DATABASE_URL=sqlite+aiosqlite:///./agrimind.db
# Production (Free Neon / Supabase PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb

# Security & Encryption
# Generate a secret with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-in-production-super-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet symmetric encryption key for storing user BYOK API keys securely
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=gAAAAABnABCdef1234567890abcdefghijklmnopqrstuvwxyz=

# Default Admin User (Seeded on first startup)
ADMIN_EMAIL=deepak.kumar.agri@jarga-farms.in
ADMIN_PASSWORD=AgriMindAdmin@2026!
ADMIN_NAME=Deepak Kumar

# AI & LLM Keys
# OpenRouter Server Shared Key (used for free model routing when user BYOK key is absent)
OPENROUTER_API_KEY=
# Google Gemini API Key
GEMINI_API_KEY=

# Government & External API Keys (Optional - Free fallback scraping is active if missing)
DATA_GOV_API_KEY=
GOOGLE_MAPS_API_KEY=AIzaSyBlhF1v3r9aXsdZN4byYfNjRqjYokmzlHw
COPENICUS_CLIENT_ID=
COPENICUS_CLIENT_SECRET=

# Scraping & Polite Rate Limits
SCRAPER_RATE_LIMIT_SECONDS=3.0
SCRAPER_USER_AGENT=AgriMindAI-Bot/1.0 (+https://agrimind.org/bot; agricultural-research)
